---
import MobileLayout from '../../layouts/MobileLayout.astro';
import Flash from '../../components/Flash.astro';
import { LEAVE_STATUS_LABELS, LEAVE_STATUS_STYLES, LEAVE_TYPES } from '../../lib/leave';
import { formatDate } from '../../lib/format';
import { todayIn } from '../../lib/datetime';
import type {
  HotelSettingsRow,
  LeaveRequestRow,
  MyLeaveBalanceRow,
} from '../../types/database';

const { supabase, actor } = Astro.locals;
const employee = actor.employee!;

const [settingsResult, balanceResult, requestsResult] = await Promise.all([
  supabase.from('hotel_settings').select('*').eq('id', true).maybeSingle(),
  supabase.rpc('my_leave_balance', {} as never),
  supabase
    .from('leave_requests')
    .select('*')
    .eq('employee_id', employee.id)
    .order('start_date', { ascending: false })
    .limit(25),
]);

const settings = settingsResult.data as HotelSettingsRow | null;
const timeZone = settings?.timezone ?? 'UTC';
const certAfterDays = Number(settings?.sick_cert_required_after_days ?? 1);

const balance = ((balanceResult.data ?? []) as MyLeaveBalanceRow[])[0] ?? null;
const requests = (requestsResult.data ?? []) as LeaveRequestRow[];
const today = todayIn(timeZone);

const pending = requests.filter((r) => r.status === 'pending');
const history = requests.filter((r) => r.status !== 'pending');

const remaining = Number(balance?.annual_remaining ?? 0);
const allocated = Number(balance?.annual_allocated ?? 0);
const usedPct = allocated > 0 ? Math.min(100, Math.round((Number(balance?.annual_used ?? 0) / allocated) * 100)) : 0;
---

<MobileLayout title="Leave" heading="Leave & time off" subheading={`${employee.department_name}`}>
  <Flash />

  <section class="card px-4 py-4">
    <div class="flex items-end justify-between gap-3">
      <div>
        <p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">
          Annual leave {balance?.year ? `· ${balance.year}` : ''}
        </p>
        <p class="mt-1 text-3xl font-semibold text-slate-900 tabular-nums">
          {remaining}
          <span class="text-base font-normal text-slate-500">of {allocated} days left</span>
        </p>
      </div>
    </div>

    <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-slate-100">
      <div class="h-full rounded-full bg-brand-500" style={`width: ${usedPct}%`}></div>
    </div>

    <dl class="mt-4 grid grid-cols-3 gap-2 text-center text-sm">
      <div class="rounded-lg bg-slate-50 px-2 py-2">
        <dt class="text-xs text-slate-500">Annual used</dt>
        <dd class="mt-0.5 font-semibold text-slate-900 tabular-nums">{balance?.annual_used ?? 0}</dd>
      </div>
      <div class="rounded-lg bg-slate-50 px-2 py-2">
        <dt class="text-xs text-slate-500">Sick</dt>
        <dd class="mt-0.5 font-semibold text-slate-900 tabular-nums">{balance?.sick_used ?? 0}</dd>
      </div>
      <div class="rounded-lg bg-slate-50 px-2 py-2">
        <dt class="text-xs text-slate-500">Unpaid</dt>
        <dd class="mt-0.5 font-semibold text-slate-900 tabular-nums">{balance?.unpaid_used ?? 0}</dd>
      </div>
    </dl>
  </section>

  <section class="card mt-4 overflow-hidden">
    <header class="border-b border-slate-200 px-4 py-3">
      <h2 class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Request time off</h2>
    </header>

    <form
      method="post"
      action="/api/leaves/request"
      enctype="multipart/form-data"
      class="space-y-4 px-4 py-4"
      novalidate
    >
      <div>
        <label class="field-label" for="leave_type">Type</label>
        <select class="field-input" id="leave_type" name="leave_type" required>
          {LEAVE_TYPES.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="field-label" for="start_date">From</label>
          <input class="field-input" id="start_date" name="start_date" type="date" min={today} required />
        </div>
        <div>
          <label class="field-label" for="end_date">To</label>
          <input class="field-input" id="end_date" name="end_date" type="date" min={today} required />
        </div>
      </div>

      <p class="field-hint" id="day-count" role="status"></p>

      <div>
        <label class="field-label" for="reason">Reason (optional)</label>
        <input class="field-input" id="reason" name="reason" maxlength="200" />
      </div>

      <div data-cert-field hidden>
        <label class="field-label" for="document">Medical certificate</label>
        <input
          class="field-input file:mr-3 file:rounded-md file:border-0 file:bg-brand-50 file:px-3 file:py-1 file:text-sm file:font-semibold file:text-brand-700"
          id="document"
          name="document"
          type="file"
          accept="application/pdf,image/jpeg,image/png"
        />
        <p class="field-hint">
          Required for sick leave longer than {certAfterDays} day{certAfterDays === 1 ? '' : 's'}.
          PDF, JPG or PNG.
        </p>
      </div>

      <button type="submit" class="btn-primary w-full">Submit request</button>
    </form>
  </section>

  {
    pending.length > 0 && (
      <section class="card mt-4 overflow-hidden">
        <header class="border-b border-slate-200 px-4 py-3">
          <h2 class="text-xs font-semibold tracking-wide text-slate-500 uppercase">
            Awaiting decision
          </h2>
        </header>
        <ul class="divide-y divide-slate-100">
          {pending.map((r) => (
            <li class="flex items-start justify-between gap-3 px-4 py-3">
              <div class="min-w-0">
                <p class="text-sm font-semibold text-slate-900">
                  {r.leave_type} · {r.days_count} day{Number(r.days_count) === 1 ? '' : 's'}
                </p>
                <p class="mt-0.5 text-xs text-slate-500">
                  {formatDate(r.start_date)} – {formatDate(r.end_date)}
                </p>
                {r.reason && <p class="mt-1 text-xs text-slate-500 italic">“{r.reason}”</p>}
                <form method="post" action="/api/leaves/cancel" class="mt-2">
                  <input type="hidden" name="id" value={r.id} />
                  <button type="submit" class="text-xs font-semibold text-rose-600 hover:underline">
                    Withdraw
                  </button>
                </form>
              </div>
              <span class:list={['pill shrink-0', LEAVE_STATUS_STYLES[r.status]]}>
                {LEAVE_STATUS_LABELS[r.status]}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="card mt-4 overflow-hidden">
    <header class="border-b border-slate-200 px-4 py-3">
      <h2 class="text-xs font-semibold tracking-wide text-slate-500 uppercase">History</h2>
    </header>
    {
      history.length === 0 ? (
        <p class="px-4 py-8 text-center text-sm text-slate-500">No past leave requests.</p>
      ) : (
        <ul class="divide-y divide-slate-100">
          {history.map((r) => (
            <li class="flex items-start justify-between gap-3 px-4 py-3">
              <div class="min-w-0">
                <p class="text-sm font-medium text-slate-900">
                  {r.leave_type} · {formatDate(r.start_date)} – {formatDate(r.end_date)}
                </p>
                {r.decision_note && (
                  <p class="mt-0.5 text-xs text-slate-500 italic">“{r.decision_note}”</p>
                )}
              </div>
              <span class:list={['pill shrink-0', LEAVE_STATUS_STYLES[r.status]]}>
                {LEAVE_STATUS_LABELS[r.status]}
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</MobileLayout>

<script is:inline define:vars={{ certAfterDays }}>
  // Mirror the two server rules the form can check cheaply: how many days the
  // range covers, and whether sick leave now needs a certificate.
  (function () {
    const type = document.querySelector('#leave_type');
    const start = document.querySelector('#start_date');
    const end = document.querySelector('#end_date');
    const count = document.querySelector('#day-count');
    const certField = document.querySelector('[data-cert-field]');
    const certInput = document.querySelector('#document');
    if (!type || !start || !end) return;

    function days() {
      if (!start.value || !end.value) return 0;
      const a = Date.parse(start.value + 'T00:00:00Z');
      const b = Date.parse(end.value + 'T00:00:00Z');
      if (Number.isNaN(a) || Number.isNaN(b) || b < a) return 0;
      return Math.round((b - a) / 86400000) + 1;
    }

    function sync() {
      const n = days();
      count.textContent = n > 0 ? `${n} day${n === 1 ? '' : 's'} requested.` : '';

      // Sick leave may be backdated, so relax the min on the date inputs.
      const sick = type.value === 'Sick';
      start.min = sick ? '' : start.dataset.min ?? start.min;

      const needsCert = sick && n > certAfterDays;
      certField.hidden = !needsCert;
      if (certInput) certInput.required = needsCert;
    }

    start.dataset.min = start.min;
    [type, start, end].forEach((el) => el.addEventListener('change', sync));
    sync();
  })();
</script>
