---
import AppLayout from '../../layouts/AppLayout.astro';
import Flash from '../../components/Flash.astro';
import { formatDateTimeIn, trimSeconds } from '../../lib/datetime';
import type { HotelSettingsRow, MasterShiftRow } from '../../types/database';

const { supabase } = Astro.locals;

const [settingsResult, shiftsResult] = await Promise.all([
  supabase.from('hotel_settings').select('*').eq('id', true).maybeSingle(),
  supabase.from('master_shifts').select('*').order('sort_order', { ascending: true }),
]);

const settings = settingsResult.data as HotelSettingsRow | null;
const shifts = (shiftsResult.data ?? []) as MasterShiftRow[];
const timeZone = settings?.timezone ?? 'UTC';
---

<AppLayout
  title="Settings"
  heading="Attendance settings"
  description="The geofence anchor and the shift definitions the roster is built from."
>
  <Flash />

  <div class="grid max-w-5xl gap-6 lg:grid-cols-2 lg:items-start">
    <section class="card p-6">
      <h2 class="text-sm font-semibold tracking-wide text-slate-500 uppercase">Property & geofence</h2>
      <p class="mt-1 text-sm text-slate-500">
        Staff can only clock in within this radius of the coordinate below.
      </p>

      <form method="post" action="/api/settings/update" class="mt-4 space-y-4" novalidate>
        <div>
          <label class="field-label" for="hotel_name">Hotel name <span class="text-rose-500">*</span></label>
          <input class="field-input" id="hotel_name" name="hotel_name" value={settings?.hotel_name ?? ''} required />
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="field-label" for="latitude">Latitude <span class="text-rose-500">*</span></label>
            <input class="field-input" id="latitude" name="latitude" value={settings?.latitude ?? ''} inputmode="decimal" required />
          </div>
          <div>
            <label class="field-label" for="longitude">Longitude <span class="text-rose-500">*</span></label>
            <input class="field-input" id="longitude" name="longitude" value={settings?.longitude ?? ''} inputmode="decimal" required />
          </div>
        </div>

        <button type="button" class="btn-secondary w-full" id="use-my-location">
          Use my current location
        </button>
        <p class="field-hint" id="location-status" role="status"></p>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="field-label" for="geofence_radius_meters">Radius (metres) <span class="text-rose-500">*</span></label>
            <input
              class="field-input"
              id="geofence_radius_meters"
              name="geofence_radius_meters"
              type="number"
              min="10"
              max="5000"
              value={settings?.geofence_radius_meters ?? 100}
              required
            />
            <p class="field-hint">Phase 2 target is 100 m.</p>
          </div>
          <div>
            <label class="field-label" for="timezone">Timezone <span class="text-rose-500">*</span></label>
            <input class="field-input" id="timezone" name="timezone" value={timeZone} required />
            <p class="field-hint">IANA name, e.g. Asia/Jakarta.</p>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="field-label" for="early_clock_in_limit_mins">Clock-in opens (min before)</label>
            <input
              class="field-input"
              id="early_clock_in_limit_mins"
              name="early_clock_in_limit_mins"
              type="number"
              min="0"
              max="480"
              value={settings?.early_clock_in_limit_mins ?? 45}
              required
            />
          </div>
          <div>
            <label class="field-label" for="photo_retention_days">Selfie retention (days)</label>
            <input
              class="field-input"
              id="photo_retention_days"
              name="photo_retention_days"
              type="number"
              min="1"
              max="3650"
              value={settings?.photo_retention_days ?? 90}
              required
            />
          </div>
        </div>

        <div class="flex items-center justify-between gap-3">
          <p class="text-xs text-slate-500">
            Last updated {formatDateTimeIn(settings?.updated_at ?? null, timeZone)}
          </p>
          <button type="submit" class="btn-primary">Save settings</button>
        </div>
      </form>
    </section>

    <section class="card p-6 lg:col-span-2">
      <h2 class="text-sm font-semibold tracking-wide text-slate-500 uppercase">
        Leave, overtime & payroll policy
      </h2>
      <p class="mt-1 text-sm text-slate-500">
        These drive the leave balances, the coverage warning, the overtime rates and the
        service-charge calculation.
      </p>

      <form method="post" action="/api/settings/policy" class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" novalidate>
        <div>
          <label class="field-label" for="annual_leave_days">Annual leave (days/year)</label>
          <input class="field-input" id="annual_leave_days" name="annual_leave_days" type="number" min="0" max="365" value={settings?.annual_leave_days ?? 12} required />
          <p class="field-hint">Seeds new balance rows.</p>
        </div>
        <div>
          <label class="field-label" for="sick_cert_required_after_days">Sick cert after (days)</label>
          <input class="field-input" id="sick_cert_required_after_days" name="sick_cert_required_after_days" type="number" min="0" max="30" value={settings?.sick_cert_required_after_days ?? 1} required />
        </div>
        <div>
          <label class="field-label" for="leave_coverage_threshold_pct">Coverage threshold (%)</label>
          <input class="field-input" id="leave_coverage_threshold_pct" name="leave_coverage_threshold_pct" type="number" min="0" max="100" value={settings?.leave_coverage_threshold_pct ?? 60} required />
          <p class="field-hint">Below this, approvals are flagged.</p>
        </div>
        <div>
          <label class="field-label" for="payroll_cutoff_day">Payroll cut-off day</label>
          <input class="field-input" id="payroll_cutoff_day" name="payroll_cutoff_day" type="number" min="1" max="28" value={settings?.payroll_cutoff_day ?? 20} required />
        </div>
        <div>
          <label class="field-label" for="overtime_multiplier">Overtime rate (×)</label>
          <input class="field-input" id="overtime_multiplier" name="overtime_multiplier" type="number" step="0.25" min="1" max="10" value={settings?.overtime_multiplier ?? 1.5} required />
        </div>
        <div>
          <label class="field-label" for="public_holiday_multiplier">Public holiday rate (×)</label>
          <input class="field-input" id="public_holiday_multiplier" name="public_holiday_multiplier" type="number" step="0.25" min="1" max="10" value={settings?.public_holiday_multiplier ?? 2} required />
        </div>
        <div>
          <label class="field-label" for="late_penalty_threshold">Late count before penalty</label>
          <input class="field-input" id="late_penalty_threshold" name="late_penalty_threshold" type="number" min="0" max="31" value={settings?.late_penalty_threshold ?? 3} required />
        </div>
        <div>
          <label class="field-label" for="late_penalty_pct">Point penalty (%)</label>
          <input class="field-input" id="late_penalty_pct" name="late_penalty_pct" type="number" step="0.5" min="0" max="100" value={settings?.late_penalty_pct ?? 10} required />
        </div>

        <div class="sm:col-span-2 lg:col-span-4 flex justify-end">
          <button type="submit" class="btn-primary">Save policy</button>
        </div>
      </form>
    </section>

    <section class="card overflow-hidden">
      <header class="border-b border-slate-200 px-5 py-4">
        <h2 class="text-sm font-semibold tracking-wide text-slate-500 uppercase">Shift definitions</h2>
        <p class="mt-1 text-sm text-slate-500">
          Rostered times are derived from these, in {timeZone}.
        </p>
      </header>

      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs tracking-wide text-slate-500 uppercase">
          <tr>
            <th scope="col" class="px-5 py-3 font-semibold">Shift</th>
            <th scope="col" class="px-5 py-3 font-semibold">Window</th>
            <th scope="col" class="px-5 py-3 font-semibold">Grace</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {
            shifts.map((s) => (
              <tr>
                <td class="px-5 py-3">
                  <p class="font-semibold text-slate-900">
                    <span class="pill mr-2 bg-brand-50 text-brand-700">{s.code}</span>
                    {s.name}
                  </p>
                  {!s.is_active && <p class="mt-0.5 text-xs text-slate-500">Inactive</p>}
                </td>
                <td class="px-5 py-3 whitespace-nowrap text-slate-600">
                  {trimSeconds(s.start_time)} – {trimSeconds(s.end_time)}
                  {s.is_overnight && (
                    <span class="ml-1 rounded bg-amber-100 px-1.5 py-0.5 text-xs font-semibold text-amber-800">
                      +1 day
                    </span>
                  )}
                </td>
                <td class="px-5 py-3 whitespace-nowrap text-slate-600">{s.grace_period_mins} min</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <footer class="border-t border-slate-200 px-5 py-3 text-xs text-slate-500">
        An overnight shift ends on the following calendar day, so the night auditor's
        hours are recorded against the day the shift started.
      </footer>
    </section>
  </div>
</AppLayout>

<script>
  // Convenience only: HR can always type the coordinate by hand.
  const button = document.querySelector<HTMLButtonElement>('#use-my-location');
  const status = document.querySelector<HTMLElement>('#location-status');
  const lat = document.querySelector<HTMLInputElement>('#latitude');
  const lng = document.querySelector<HTMLInputElement>('#longitude');

  button?.addEventListener('click', () => {
    if (!navigator.geolocation) {
      if (status) status.textContent = 'This browser cannot report a location.';
      return;
    }

    button.disabled = true;
    if (status) status.textContent = 'Reading location…';

    navigator.geolocation.getCurrentPosition(
      (position) => {
        if (lat) lat.value = position.coords.latitude.toFixed(6);
        if (lng) lng.value = position.coords.longitude.toFixed(6);
        if (status) {
          status.textContent = `Filled in, accurate to about ${Math.round(position.coords.accuracy)} m. Save to apply.`;
        }
        button.disabled = false;
      },
      (error) => {
        if (status) status.textContent = `Could not read location: ${error.message}`;
        button.disabled = false;
      },
      { enableHighAccuracy: true, timeout: 10000 },
    );
  });
</script>
