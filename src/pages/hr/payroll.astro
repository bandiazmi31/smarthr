---
import AppLayout from '../../layouts/AppLayout.astro';
import Flash from '../../components/Flash.astro';
import { MONTH_NAMES, PRE_PAYROLL_COLUMNS, totalsFor } from '../../lib/payroll';
import { formatDate } from '../../lib/format';
import { formatDateTimeIn, formatMinutes, todayIn } from '../../lib/datetime';
import type {
  HotelSettingsRow,
  PayrollPeriodRow,
  PrePayrollRow,
} from '../../types/database';

const { supabase } = Astro.locals;
const url = Astro.url;

const { data: settingsRow } = await supabase
  .from('hotel_settings').select('*').eq('id', true).maybeSingle();
const settings = settingsRow as HotelSettingsRow | null;
const timeZone = settings?.timezone ?? 'UTC';
const cutoffDay = Number(settings?.payroll_cutoff_day ?? 20);

const today = todayIn(timeZone);
const thisYear = Number(today.slice(0, 4));
const thisMonth = Number(today.slice(5, 7));

const selectedId = url.searchParams.get('period') ?? '';

const { data: periodRows } = await supabase
  .from('payroll_periods')
  .select('*')
  .order('start_date', { ascending: false })
  .limit(24);

const periods = (periodRows ?? []) as PayrollPeriodRow[];
const selected = periods.find((p) => p.id === selectedId) ?? periods[0] ?? null;

let rows: PrePayrollRow[] = [];
let loadError: string | null = null;

if (selected) {
  const { data, error } = await supabase.rpc('pre_payroll_timesheet', {
    p_start: selected.start_date,
    p_end: selected.end_date,
  } as never);
  rows = (data ?? []) as PrePayrollRow[];
  loadError = error?.message ?? null;
}

const totals = totalsFor(rows);
const years = [thisYear - 1, thisYear, thisYear + 1];
---

<AppLayout
  title="Pre-payroll"
  heading="Pre-payroll consolidation"
  description={`Cut-off runs ${cutoffDay}th to ${cutoffDay}th. Locking a period freezes its attendance and overtime.`}
>
  <Flash />

  {
    loadError && (
      <div role="alert" class="mb-5 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
        Could not build the timesheet: {loadError}
      </div>
    )
  }

  <div class="grid gap-6 xl:grid-cols-[320px_1fr] xl:items-start">
    <div class="space-y-6 xl:sticky xl:top-6">
      <section class="card p-5">
        <h2 class="text-sm font-semibold tracking-wide text-slate-500 uppercase">New cut-off period</h2>
        <form method="post" action="/api/payroll/period" class="mt-3 space-y-3">
          <input type="hidden" name="action" value="create" />
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="field-label" for="month">Month</label>
              <select class="field-input" id="month" name="month">
                {MONTH_NAMES.map((name, i) => (
                  <option value={i + 1} selected={i + 1 === thisMonth}>{name}</option>
                ))}
              </select>
            </div>
            <div>
              <label class="field-label" for="year">Year</label>
              <select class="field-input" id="year" name="year">
                {years.map((y) => <option value={y} selected={y === thisYear}>{y}</option>)}
              </select>
            </div>
          </div>
          <button type="submit" class="btn-primary w-full">Create period</button>
        </form>
      </section>

      <section class="card overflow-hidden">
        <header class="border-b border-slate-200 px-5 py-3">
          <h2 class="text-sm font-semibold tracking-wide text-slate-500 uppercase">Periods</h2>
        </header>
        {
          periods.length === 0 ? (
            <p class="px-5 py-8 text-center text-sm text-slate-500">
              No periods yet. Create one to start a cut-off.
            </p>
          ) : (
            <ul class="divide-y divide-slate-100">
              {periods.map((p) => (
                <li class:list={['px-5 py-3', p.id === selected?.id && 'bg-brand-50/60']}>
                  <a class="block" href={`/hr/payroll?period=${p.id}`}>
                    <p class="text-sm font-semibold text-slate-900">{p.label}</p>
                    <p class="text-xs text-slate-500">
                      {formatDate(p.start_date)} – {formatDate(p.end_date)}
                    </p>
                  </a>
                  <div class="mt-2 flex items-center gap-2">
                    <span
                      class:list={[
                        'pill',
                        p.status === 'locked'
                          ? 'bg-slate-800 text-white'
                          : 'bg-emerald-100 text-emerald-800',
                      ]}
                    >
                      {p.status}
                    </span>
                    <form method="post" action="/api/payroll/period">
                      <input type="hidden" name="id" value={p.id} />
                      <input type="hidden" name="action" value={p.status === 'locked' ? 'unlock' : 'lock'} />
                      <button type="submit" class="text-xs font-semibold text-brand-700 hover:underline">
                        {p.status === 'locked' ? 'Reopen' : 'Lock cut-off'}
                      </button>
                    </form>
                  </div>
                  {p.locked_at && (
                    <p class="mt-1 text-xs text-slate-400">
                      Locked {formatDateTimeIn(p.locked_at, timeZone)}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </div>

    <section class="card overflow-hidden">
      <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-5 py-4">
        <div>
          <h2 class="text-sm font-semibold tracking-wide text-slate-500 uppercase">
            {selected ? `Timesheet · ${selected.label}` : 'Timesheet'}
          </h2>
          {selected && (
            <p class="mt-1 text-sm text-slate-500">
              {formatDate(selected.start_date)} – {formatDate(selected.end_date)} ·{' '}
              {rows.length} employee{rows.length === 1 ? '' : 's'}
            </p>
          )}
        </div>

        {
          selected && (
            <div class="flex flex-wrap items-center gap-2">
              <form method="post" action="/api/payroll/generate-points">
                <input type="hidden" name="month" value={Number(selected.end_date.slice(5, 7))} />
                <input type="hidden" name="year" value={Number(selected.end_date.slice(0, 4))} />
                <button type="submit" class="btn-secondary">Recalculate points</button>
              </form>
              <a
                class="btn-primary"
                href={`/api/payroll/pre-payroll-export?start=${selected.start_date}&end=${selected.end_date}`}
              >
                Export .xlsx
              </a>
            </div>
          )
        }
      </header>

      {
        !selected ? (
          <p class="px-5 py-16 text-center text-sm text-slate-500">
            Create a cut-off period to build a timesheet.
          </p>
        ) : rows.length === 0 ? (
          <p class="px-5 py-16 text-center text-sm text-slate-500">
            No active employees in this period.
          </p>
        ) : (
          <>
            <div class="grid gap-4 border-b border-slate-200 px-5 py-4 sm:grid-cols-4">
              <div>
                <p class="text-xs text-slate-500">Scheduled days</p>
                <p class="text-xl font-semibold tabular-nums text-slate-900">{totals.scheduledDays}</p>
              </div>
              <div>
                <p class="text-xs text-slate-500">Worked days</p>
                <p class="text-xl font-semibold tabular-nums text-slate-900">{totals.workedDays}</p>
              </div>
              <div>
                <p class="text-xs text-slate-500">Late instances</p>
                <p class:list={['text-xl font-semibold tabular-nums', totals.lateCount > 0 ? 'text-rose-600' : 'text-slate-900']}>
                  {totals.lateCount}
                </p>
              </div>
              <div>
                <p class="text-xs text-slate-500">Service charge points</p>
                <p class="text-xl font-semibold tabular-nums text-brand-700">
                  {Math.round(totals.points * 1000) / 1000}
                </p>
              </div>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm whitespace-nowrap">
                <thead class="bg-slate-50 text-xs tracking-wide text-slate-500 uppercase">
                  <tr>
                    {PRE_PAYROLL_COLUMNS.map((c) => (
                      <th scope="col" class:list={['px-4 py-3 font-semibold', c.numeric && 'text-right']}>
                        {c.header}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {rows.map((row) => (
                    <tr class="hover:bg-slate-50/75">
                      {PRE_PAYROLL_COLUMNS.map((c) => (
                        <td class:list={['px-4 py-2', c.numeric && 'text-right tabular-nums']}>
                          {c.key === 'total_late_minutes' || c.key === 'total_worked_minutes'
                            ? formatMinutes(Number(row[c.key]))
                            : String(row[c.key])}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )
      }

      <footer class="border-t border-slate-200 px-5 py-3 text-xs text-slate-500">
        Overtime counts approved hours only. Service charge points come from the last
        recalculation for the period — run it again after any attendance correction, and
        before locking the cut-off.
      </footer>
    </section>
  </div>
</AppLayout>
