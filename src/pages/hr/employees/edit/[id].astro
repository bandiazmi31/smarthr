---
import AppLayout from '../../../../layouts/AppLayout.astro';
import EmployeeForm from '../../../../components/EmployeeForm.astro';
import Flash from '../../../../components/Flash.astro';
import AlertBadge from '../../../../components/AlertBadge.astro';
import StatusPill from '../../../../components/StatusPill.astro';
import { DOCUMENT_TYPES, MAX_DOCUMENT_BYTES } from '../../../../lib/constants';
import { takeFormFlash } from '../../../../lib/flash';
import { formatDate, formatDateTime, formatFileSize } from '../../../../lib/format';
import type { ContractStatusRow, EmployeeDocumentRow } from '../../../../types/database';

const { supabase } = Astro.locals;
const { id } = Astro.params;

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
if (!id || !UUID.test(id)) {
  return Astro.redirect('/hr/employees?error=not_found', 303);
}

const flash = takeFormFlash(Astro.cookies);

const [employeeResult, documentResult, departmentRows, shiftRows] = await Promise.all([
  supabase.from('employee_contract_status').select('*').eq('id', id).maybeSingle(),
  supabase
    .from('employee_documents')
    .select('*')
    .eq('employee_id', id)
    .order('uploaded_at', { ascending: false }),
  supabase.from('departments').select('id, name').order('name', { ascending: true }),
  supabase
    .from('master_shifts')
    .select('id, name, code')
    .eq('is_active', true)
    .order('sort_order', { ascending: true }),
]);

const employee = employeeResult.data as ContractStatusRow | null;
if (!employee) {
  return Astro.redirect('/hr/employees?error=not_found', 303);
}

const documents = (documentResult.data ?? []) as EmployeeDocumentRow[];
const departments = departmentRows.data ?? [];
const shifts = shiftRows.data ?? [];

// Values the form renders: the rejected submission if there is one, else the stored row.
const stored: Record<string, string> = {
  employee_id: employee.employee_id,
  full_name: employee.full_name,
  phone: employee.phone ?? '',
  national_id: employee.national_id ?? '',
  email: employee.email ?? '',
  address: employee.address ?? '',
  birth_date: employee.birth_date ?? '',
  department_id: employee.department_id,
  job_title: employee.job_title,
  employment_status: employee.employment_status,
  join_date: employee.join_date,
  end_date: employee.end_date ?? '',
  notes: employee.notes ?? '',
  portal_enabled: employee.portal_enabled ? 'on' : '',
  role: employee.role,
  auto_schedule_shift_id: employee.auto_schedule_shift_id ?? '',
};

const hasErrors = Boolean(flash && Object.keys(flash.errors).length > 0);
const values = hasErrors ? { ...stored, ...flash!.values } : stored;

const acceptedTypes = 'application/pdf,image/jpeg,image/png';
---

<AppLayout
  title={employee.full_name}
  heading={employee.full_name}
  description={`${employee.employee_id} · ${employee.job_title}, ${employee.department}`}
>
  <div class="mx-auto max-w-5xl space-y-6">
    <Flash />

    {
      hasErrors && (
        <div role="alert" class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
          Please correct the highlighted fields. Nothing has been saved yet.
        </div>
      )
    }

    <section class="card flex flex-wrap items-center justify-between gap-4 px-5 py-4">
      <div class="flex flex-wrap items-center gap-3">
        <StatusPill isActive={employee.is_active} />
        {employee.is_active && (
          <AlertBadge level={employee.alert_level} daysRemaining={employee.days_remaining} />
        )}
        <span class="text-sm text-slate-500">
          Joined {formatDate(employee.join_date)}
          {employee.end_date && <> · contract ends {formatDate(employee.end_date)}</>}
        </span>
      </div>

      <div class="flex items-center gap-2">
        <a class="btn-secondary" href="/hr/employees">Back to directory</a>
      </div>
    </section>

    {
      !employee.is_active && (
        <section class="card border-slate-300 bg-slate-50 px-5 py-4">
          <h2 class="text-sm font-semibold text-slate-800">Alumni record</h2>
          <p class="mt-1 text-sm text-slate-600">
            Deactivated {formatDateTime(employee.deactivated_at)}
            {employee.deactivation_reason && <> · {employee.deactivation_reason}</>}
          </p>
          <form method="post" action="/api/employees/deactivate" class="mt-3">
            <input type="hidden" name="id" value={employee.id} />
            <input type="hidden" name="action" value="reactivate" />
            <button type="submit" class="btn-secondary">Reactivate employee</button>
          </form>
        </section>
      )
    }

    <EmployeeForm
      action="/api/employees/update"
      values={values}
      errors={flash?.errors}
      departments={departments}
      shifts={shifts}
      submitLabel="Save changes"
      cancelHref="/hr/employees"
      employeeUuid={employee.id}
    />

    <section class="card overflow-hidden">
      <header class="border-b border-slate-200 px-5 py-4">
        <h2 class="text-sm font-semibold tracking-wide text-slate-500 uppercase">
          Document archive
        </h2>
        <p class="mt-1 text-sm text-slate-500">
          Stored in a private bucket. Links are signed on demand and expire after a few minutes.
        </p>
      </header>

      <form
        method="post"
        action="/api/employees/upload-doc"
        enctype="multipart/form-data"
        class="grid gap-4 border-b border-slate-200 bg-slate-50 px-5 py-4 sm:grid-cols-[180px_1fr_auto] sm:items-end"
      >
        <input type="hidden" name="employee_id" value={employee.id} />

        <div>
          <label class="field-label" for="document_type">Document type</label>
          <select class="field-input" id="document_type" name="document_type" required>
            {DOCUMENT_TYPES.map((type) => <option value={type}>{type}</option>)}
          </select>
        </div>

        <div>
          <label class="field-label" for="file">File</label>
          <input
            class="field-input file:mr-3 file:rounded-md file:border-0 file:bg-brand-50 file:px-3 file:py-1 file:text-sm file:font-semibold file:text-brand-700"
            id="file"
            name="file"
            type="file"
            accept={acceptedTypes}
            required
          />
          <p class="field-hint">
            PDF, JPG or PNG · up to {Math.round(MAX_DOCUMENT_BYTES / (1024 * 1024))} MB
          </p>
        </div>

        <button type="submit" class="btn-primary">Upload</button>
      </form>

      {
        documents.length === 0 ? (
          <p class="px-5 py-10 text-center text-sm text-slate-500">
            No documents yet. Upload the ID card and signed contract to complete this record.
          </p>
        ) : (
          <ul class="divide-y divide-slate-100">
            {
              documents.map((doc) => (
                <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-3">
                  <div class="min-w-0">
                    <p class="text-sm font-semibold text-slate-900">
                      <span class="pill mr-2 bg-brand-50 text-brand-700">{doc.document_type}</span>
                      {doc.file_name}
                    </p>
                    <p class="mt-1 text-xs text-slate-500">
                      {formatFileSize(doc.file_size)} · uploaded {formatDateTime(doc.uploaded_at)}
                    </p>
                  </div>

                  <div class="flex items-center gap-2">
                    <a
                      class="btn-secondary"
                      href={`/api/employees/document-url?id=${doc.id}`}
                      target="_blank"
                      rel="noopener"
                    >
                      View
                    </a>
                    <form method="post" action="/api/employees/delete-doc">
                      <input type="hidden" name="id" value={doc.id} />
                      <input type="hidden" name="employee_id" value={employee.id} />
                      <button type="submit" class="btn-danger">Delete</button>
                    </form>
                  </div>
                </li>
              ))
            }
          </ul>
        )
      }
    </section>

    {
      employee.is_active && (
        <section class="card border-rose-200 px-5 py-4">
          <h2 class="text-sm font-semibold text-rose-800">Deactivate employee</h2>
          <p class="mt-1 text-sm text-slate-600">
            A soft delete: the record and its documents stay on file as an alumni entry, and the
            employee drops out of the active directory and contract alerts.
          </p>

          <details class="mt-3">
            <summary class="btn-danger cursor-pointer">Deactivate…</summary>
            <form method="post" action="/api/employees/deactivate" class="mt-4 max-w-xl space-y-3">
              <input type="hidden" name="id" value={employee.id} />

              <div>
                <label class="field-label" for="deactivation_reason">Reason</label>
                <input
                  class="field-input"
                  id="deactivation_reason"
                  name="deactivation_reason"
                  placeholder="e.g. Resigned effective 30 Nov"
                  required
                />
              </div>

              <div class="flex items-center gap-2">
                <button type="submit" class="btn-danger">Confirm deactivation</button>
                <span class="text-xs text-slate-500">This can be reversed.</span>
              </div>
            </form>
          </details>
        </section>
      )
    }
  </div>
</AppLayout>
